      "step-4": {
        "$type": "string",
        "$value": "steps(4, end)"
      },
      "step-8": {
        "$type": "string",
        "$value": "steps(8, end)"
      },
      "fade": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  },
