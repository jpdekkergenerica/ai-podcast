    "float": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px",
        "color": "rgba(0,0,0,0.08)"
      },
      "$description": "Paper mode only — sheets, toasts, floating tab bar, ⊕. LED uses a 1px border-default instead."
    }
